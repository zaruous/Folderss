<Project Sdk="Microsoft.NET.Sdk">

  <!--
    플러그인과 Folderss 본체가 함께 참조하는 계약(인터페이스)만 담는다. 본체 내부 형식은 넣지 않는다 —
    넣으면 본체를 고칠 때마다 플러그인이 깨진다.
    플러그인 프로젝트는 이 DLL을 복사하지 않도록 참조한다(Private=false). 복사돼도 로더는 본체의 것을 쓴다.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>Folderss.Plugins</RootNamespace>
    <AssemblyName>Folderss.PluginContract</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
