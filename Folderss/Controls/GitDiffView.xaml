<UserControl x:Class="Folderss.Controls.GitDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,4">
            <Button x:Name="ExternalToolButton"
                    DockPanel.Dock="Right"
                    Content="외부 도구로 비교"
                    Style="{StaticResource CompactToolButtonStyle}"
                    Visibility="Collapsed"
                    Click="ExternalToolButton_Click"
                    ToolTip="설정 &gt; Git에서 지정한 비교 도구(WinMerge, Beyond Compare 등)로 같은 비교를 엽니다"/>
            <TextBlock x:Name="TitleText"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Grid>
            <ListBox x:Name="LineList"
                     FontFamily="Consolas"
                     FontSize="12"
                     SelectionMode="Extended"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     KeyDown="LineList_KeyDown"
                     ToolTip="Ctrl+C: 선택한 줄 복사">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 추가/삭제 색은 테마와 무관하게 반투명 초록/빨강을 깔아 어두운·밝은 테마 모두에서 읽히게 한다. -->
                        <Grid x:Name="Row" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding OldLine}" TextAlignment="Right" Margin="0,0,6,0"
                                       Foreground="{DynamicResource SecondaryText}"/>
                            <TextBlock Grid.Column="1" Text="{Binding NewLine}" TextAlignment="Right" Margin="0,0,8,0"
                                       Foreground="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="LineText" Grid.Column="2" Text="{Binding Text}"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter TargetName="Row" Property="Background" Value="#3328A745"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                <Setter TargetName="Row" Property="Background" Value="#33D73A49"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Hunk">
                                <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Header">
                                <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                <Setter TargetName="LineText" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Meta">
                                <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                <Setter TargetName="LineText" Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="MessageText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="12"
                       Foreground="{DynamicResource SecondaryText}"/>
        </Grid>
    </DockPanel>
</UserControl>
