<UserControl x:Class="Folderss.Controls.DiskUsageMiniPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Folderss.Converters"
             IsVisibleChanged="UserControl_IsVisibleChanged">
    <UserControl.Resources>
        <conv:FractionToStarConverter x:Key="FractionToStarConverter"/>
    </UserControl.Resources>
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="새로 고침" Click="Refresh_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource PanelBackground}">
        <ItemsControl x:Name="DriveList" Margin="8,6">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotalGB, StringFormat=총 {0:0.0} GB}"/>
                                    <TextBlock Text="{Binding UsedGB, StringFormat=사용 {0:0.0} GB}"/>
                                    <TextBlock Text="{Binding FreeGB, StringFormat=남음 {0:0.0} GB}"/>
                                </StackPanel>
                            </ToolTip>
                        </StackPanel.ToolTip>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DisplayName}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PrimaryText}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FreeGB, StringFormat={}{0:0.0} GB 남음}"
                                       FontSize="10"
                                       Margin="6,0,0,0"
                                       Foreground="{DynamicResource SecondaryText}"/>
                        </Grid>
                        <Border Height="6"
                                Margin="0,3,0,0"
                                CornerRadius="2"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding UsedFraction, Converter={StaticResource FractionToStarConverter}}"/>
                                    <ColumnDefinition Width="{Binding FreeFraction, Converter={StaticResource FractionToStarConverter}}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource AccentBrush}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
