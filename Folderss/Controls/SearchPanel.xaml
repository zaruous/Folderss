<UserControl x:Class="Folderss.Controls.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="SearchPanel_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 검색 입력 툴바 -->
        <Border Grid.Row="0"
                Padding="6,5"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- 대상 폴더: 어떤 폴더를 검색 중인지 항상 보이게 한다 -->
                <DockPanel Margin="0,0,0,5">
                    <TextBlock DockPanel.Dock="Left"
                               Text="대상 폴더"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource SecondaryText}"/>
                    <Button x:Name="BrowseRootButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource CompactToolButtonStyle}"
                            Content="폴더 선택…"
                            ToolTip="검색할 폴더를 직접 고릅니다. 고른 뒤에는 활성 패널을 따라가지 않습니다."
                            Width="84"
                            Margin="4,0,0,0"
                            Click="BrowseRootButton_Click"/>
                    <Button x:Name="UseActivePaneButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource CompactToolButtonStyle}"
                            Content="현재 폴더"
                            ToolTip="고정을 풀고 활성 폴더 패널을 다시 따라갑니다."
                            Width="72"
                            Margin="4,0,0,0"
                            IsEnabled="False"
                            Click="UseActivePaneButton_Click"/>
                    <TextBox x:Name="RootPathBox"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Padding="4,2"
                             ToolTip="현재 검색 대상 폴더"/>
                </DockPanel>

                <DockPanel>
                <!-- 범위 선택 -->
                <ComboBox x:Name="ScopeCombo"
                          DockPanel.Dock="Right"
                          Width="120"
                          Margin="4,0,0,0"
                          VerticalContentAlignment="Center"
                          SelectionChanged="ScopeCombo_SelectionChanged">
                    <ComboBoxItem Content="현재 폴더만" Tag="current"/>
                    <ComboBoxItem Content="하위 폴더 포함" IsSelected="True" Tag="recursive"/>
                </ComboBox>

                <!-- 검색 대상 선택 -->
                <ComboBox x:Name="TargetCombo"
                          DockPanel.Dock="Right"
                          Width="100"
                          Margin="4,0,0,0"
                          VerticalContentAlignment="Center"
                          SelectionChanged="ScopeCombo_SelectionChanged">
                    <ComboBoxItem Content="내용 검색" Tag="content"/>
                    <ComboBoxItem Content="파일명 검색" IsSelected="True" Tag="filename"/>
                </ComboBox>

                <!-- 옵션 토글 -->
                <ToggleButton x:Name="RegexToggle"
                              DockPanel.Dock="Right"
                              Style="{StaticResource CompactToggleButtonStyle}"
                              Content=".*"
                              ToolTip="정규식 사용"
                              Width="28"
                              Margin="4,0,0,0"
                              Checked="Option_Changed"
                              Unchecked="Option_Changed"/>
                <ToggleButton x:Name="CaseToggle"
                              DockPanel.Dock="Right"
                              Style="{StaticResource CompactToggleButtonStyle}"
                              Content="Aa"
                              ToolTip="대/소문자 구분"
                              Width="28"
                              Margin="4,0,0,0"
                              Checked="Option_Changed"
                              Unchecked="Option_Changed"/>

                <!-- 결과 목록의 '내용' 컬럼 표시 여부 -->
                <ToggleButton x:Name="ContentColumnToggle"
                              DockPanel.Dock="Right"
                              Style="{StaticResource CompactToggleButtonStyle}"
                              Content="내용"
                              ToolTip="결과 목록에 일치한 줄 내용 표시"
                              IsChecked="True"
                              Width="40"
                              Margin="4,0,0,0"
                              Checked="ContentColumnToggle_Changed"
                              Unchecked="ContentColumnToggle_Changed"/>

                <!-- 검색어 입력 -->
                <Grid>
                    <TextBox x:Name="QueryBox"
                             VerticalContentAlignment="Center"
                             Padding="4,2"
                             ToolTip="검색어 입력. 파일명 검색에서는 *, ? 와일드카드 패턴을 쓸 수 있습니다 (예: *.cs, report?.txt)"
                             KeyDown="QueryBox_KeyDown"
                             TextChanged="QueryBox_TextChanged"/>
                    <TextBlock Text="검색어 또는 패턴을 입력하세요 (예: *.cs) — Enter"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource SecondaryText}"
                               VerticalAlignment="Center"
                               Margin="6,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 결과 목록 -->
        <ListView x:Name="ResultList"
                  Grid.Row="1"
                  Background="{DynamicResource WindowBackground}"
                  Foreground="{DynamicResource PrimaryText}"
                  BorderThickness="0"
                  MouseDoubleClick="ResultList_MouseDoubleClick"
                  PreviewMouseRightButtonDown="ResultList_PreviewMouseRightButtonDown"
                  MouseRightButtonUp="ResultList_MouseRightButtonUp"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Padding="6,3"
                                    Background="{DynamicResource SurfaceBackground}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text=" ("
                                               Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBlock Text="{Binding ItemCount}"
                                               Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBlock Text="건)"
                                               Foreground="{DynamicResource SecondaryText}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="줄" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- 파일명 검색 결과는 LineNumber가 0(해당 없음)이라 빈 칸으로 표시 -->
                                <TextBlock Foreground="{DynamicResource SecondaryText}"
                                           HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding LineNumber}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LineNumber}" Value="0">
                                                    <Setter Property="Text" Value=""/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ContentColumn" Header="내용" Width="500">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LineText}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="경로" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FolderPath}"
                                           Foreground="{DynamicResource SecondaryText}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 상태 바 -->
        <Border Grid.Row="2"
                Padding="8,3"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="CancelButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource CompactToolButtonStyle}"
                        Content="취소"
                        Width="44"
                        Visibility="Collapsed"
                        Click="CancelButton_Click"/>
                <Button x:Name="NextButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource CompactToolButtonStyle}"
                        Content="다음 ▶"
                        Width="64"
                        Margin="4,0,0,0"
                        Visibility="Collapsed"
                        Click="NextButton_Click"/>
                <Button x:Name="PrevButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource CompactToolButtonStyle}"
                        Content="◀ 이전"
                        Width="64"
                        Margin="4,0,0,0"
                        Visibility="Collapsed"
                        Click="PrevButton_Click"/>
                <Button x:Name="ApplyFilterButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource CompactToolButtonStyle}"
                        Content="패널에 필터 적용"
                        Padding="8,0"
                        Margin="4,0,0,0"
                        Visibility="Collapsed"
                        ToolTip="활성 폴더 패널에 이 검색 결과만 보이도록 필터를 적용합니다. 결과가 있는 하위 폴더로는 내려갈 수 있고, 패널 상단의 '해제' 버튼으로 풉니다."
                        Click="ApplyFilterButton_Click"/>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}"
                           Text="검색어를 입력하고 Enter를 누르세요."/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
