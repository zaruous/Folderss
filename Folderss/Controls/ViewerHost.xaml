<UserControl x:Class="Folderss.Controls.ViewerHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="4,3"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <!-- .md·.markdown 탭: 블록 편집 ↔ 미리보기(Markdown 뷰어) 전환(#81). 확장자 매핑은 바꾸지 않고 이 탭만 바꾼다. -->
                    <StackPanel x:Name="ViewSwitchPanel"
                                Orientation="Horizontal"
                                Margin="0,0,8,0"
                                Visibility="Collapsed">
                        <ToggleButton x:Name="BlocksViewButton"
                                      Style="{StaticResource CompactToggleButtonStyle}"
                                      Content="블록 편집"
                                      ToolTip="블록 편집기로 보기 (이 탭만, 파일별로 기억)"
                                      Height="24"
                                      MinWidth="68"
                                      Click="BlocksView_Click"/>
                        <ToggleButton x:Name="PreviewViewButton"
                                      Style="{StaticResource CompactToggleButtonStyle}"
                                      Content="미리보기"
                                      ToolTip="Markdown 뷰어로 보기 — 내보내기·인쇄·원문 편집 (이 탭만, 파일별로 기억)"
                                      Height="24"
                                      MinWidth="68"
                                      Margin="2,0,0,0"
                                      Click="PreviewView_Click"/>
                    </StackPanel>
                    <Button x:Name="RefreshButton"
                            ToolTip="다시 읽기"
                            Width="28"
                            Height="24"
                            Padding="0"
                            Click="Refresh_Click">
                        <TextBlock Text="↻" FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="FilePathText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Margin="4,0,8,0"/>
            </DockPanel>
        </Border>
        <ContentControl x:Name="HostContent"/>
    </DockPanel>
</UserControl>
