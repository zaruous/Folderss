<UserControl x:Class="Folderss.Controls.DiskUsagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Folderss.Converters"
             MinWidth="260">
    <UserControl.Resources>
        <conv:FractionToStarConverter x:Key="FractionToStarConverter"/>
    </UserControl.Resources>
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,10"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="디스크 사용량"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="새로 고침"
                        Padding="10,4"
                        Click="Refresh_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DriveList" Margin="12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,16"
                                Padding="12"
                                Background="{DynamicResource PanelBackground}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,0,0,8"/>

                                <Border Height="18"
                                        CornerRadius="3"
                                        Background="{DynamicResource ControlBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding UsedFraction, Converter={StaticResource FractionToStarConverter}}"/>
                                            <ColumnDefinition Width="{Binding FreeFraction, Converter={StaticResource FractionToStarConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="총 " Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                    <TextBlock Text="{Binding TotalGB, StringFormat={}{0:0.0} GB}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="   ·   사용 " Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                    <TextBlock Text="{Binding UsedGB, StringFormat={}{0:0.0} GB}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="   ·   남음 " Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                    <TextBlock Text="{Binding FreeGB, StringFormat={}{0:0.0} GB}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
