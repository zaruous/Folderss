<UserControl x:Class="Folderss.Viewers.MonacoLanguagePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Monaco 탭 툴바 언어 선택(#82): 현재 언어 표시 + 검색 가능한 목록. 고른 언어는 이 파일만, 파일별로 기억한다. -->
    <Grid>
        <ToggleButton x:Name="PickerButton"
                      Style="{StaticResource CompactToggleButtonStyle}"
                      Height="24"
                      MinWidth="80"
                      Padding="8,0"
                      ToolTip="편집기 언어(구문 강조) — 이 파일만 바꾸고 파일별로 기억합니다. '자동'은 기억을 지웁니다."
                      Click="PickerButton_Click">
            <StackPanel Orientation="Horizontal" Margin="6,0">
                <TextBlock x:Name="PickerText" VerticalAlignment="Center"/>
                <TextBlock Text=" ▾" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
            </StackPanel>
        </ToggleButton>
        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=PickerButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               Opened="PickerPopup_Opened"
               Closed="PickerPopup_Closed">
            <Border Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="4"
                    Width="260">
                <DockPanel>
                    <TextBox x:Name="FilterBox"
                             DockPanel.Dock="Top"
                             Margin="0,0,0,4"
                             ToolTip="이름·id·확장자(.go)로 찾기"
                             TextChanged="FilterBox_TextChanged"
                             PreviewKeyDown="FilterBox_PreviewKeyDown"/>
                    <ListBox x:Name="LanguageList"
                             Height="320"
                             BorderThickness="0"
                             DisplayMemberPath="Label"
                             MouseUp="LanguageList_MouseUp"
                             PreviewKeyDown="LanguageList_PreviewKeyDown"/>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
