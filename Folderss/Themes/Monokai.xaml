<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 테마 정보(생략 가능): 저장·플러그인에 쓰는 이름(파일 이름과 같게), 메뉴 표시 이름, 목록 순서 -->
    <sys:String x:Key="ThemeName">Monokai</sys:String>
    <sys:String x:Key="ThemeDisplayName">Monokai</sys:String>
    <sys:Int32 x:Key="ThemeOrder">120</sys:Int32>

    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

    <Color x:Key="WindowBackgroundColor">#19181A</Color>
    <Color x:Key="PanelBackgroundColor">#221F22</Color>
    <Color x:Key="SurfaceBackgroundColor">#2A272B</Color>
    <Color x:Key="ControlBackgroundColor">#363337</Color>
    <Color x:Key="ControlHoverColor">#403E41</Color>
    <Color x:Key="ControlPressedColor">#4A474B</Color>
    <Color x:Key="BorderColor">#3A373B</Color>
    <Color x:Key="PrimaryTextColor">#FCFCFA</Color>
    <Color x:Key="SecondaryTextColor">#C1C0C0</Color>
    <Color x:Key="DisabledTextColor">#727072</Color>
    <Color x:Key="AccentColor">#FFD866</Color>
    <Color x:Key="AccentHoverColor">#FFE28F</Color>
    <Color x:Key="SelectionColor">#4A4430</Color>
    <Color x:Key="RowHoverColor">#2B282C</Color>

    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBackground" Color="{StaticResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlBackground" Color="{StaticResource ControlBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="PrimaryText" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryText" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}"/>

    <!-- 폴더 비교 창 행 배경(반투명). 다름=노랑, 이쪽만=초록, 유형 다름=빨강, 방향 색 옵션: 최신=빨강, 오래됨=회색 -->
    <SolidColorBrush x:Key="CompareDifferentBrush" Color="#4DF5B800"/>
    <SolidColorBrush x:Key="CompareThisOnlyBrush" Color="#4D2EA043"/>
    <SolidColorBrush x:Key="CompareTypeMismatchBrush" Color="#4DE5534B"/>
    <SolidColorBrush x:Key="CompareNewerBrush" Color="#4DE5534B"/>
    <SolidColorBrush x:Key="CompareOlderBrush" Color="#4D8B949E"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource ControlBackgroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{StaticResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="{StaticResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="{StaticResource ControlHoverColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource PrimaryTextColor}"/>
</ResourceDictionary>
