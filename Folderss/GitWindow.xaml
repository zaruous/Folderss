<Window x:Class="Folderss.GitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Folderss.Controls"
        Title="Git"
        Width="1100"
        Height="720"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="13"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <!-- 변경 사항 트리 보기(변경됨·스테이지됨 공용). 기본은 모두 펼침. -->
        <Style x:Key="GitChangeTreeStyle" TargetType="TreeView">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                        <Setter Property="ToolTip" Value="{Binding Path}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding DisplayText}"/>
                    </HierarchicalDataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="130" MinHeight="50"/>
        </Grid.RowDefinitions>

        <!-- 툴바 -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="RescanButton" Content="⟳ 다시 찾기" Click="Rescan_Click"
                            ToolTip="기준 폴더 아래 저장소를 다시 찾고 상태를 읽습니다"/>
                    <Button x:Name="FetchAllButton" Content="⇣ 전체 fetch" Click="FetchAll_Click"
                            ToolTip="목록의 모든 저장소에서 git fetch --prune을 실행합니다 (작업 트리는 바뀌지 않음)"/>
                    <Border Width="1" Margin="6,4" Background="{DynamicResource BorderBrush}"/>
                    <Button x:Name="PullButton" Content="⇣ pull" Click="Pull_Click"
                            ToolTip="선택한 저장소만 pull (방식은 옵션에서 선택)"/>
                    <Button x:Name="PushButton" Content="⇡ push" Click="Push_Click"
                            ToolTip="선택한 저장소만 push (강제 푸시 없음)"/>
                    <Border Width="1" Margin="6,4" Background="{DynamicResource BorderBrush}"/>
                    <Button x:Name="OptionsButton" Content="설정…" Click="Options_Click"
                            ToolTip="설정 창의 Git 탭을 엽니다 (git 경로, pull 방식, 탐색, diff·외부 비교 도구)"/>
                    <Button x:Name="CancelButton" Content="취소" Click="Cancel_Click" IsEnabled="False"
                            ToolTip="진행 중인 탐색·git 명령을 중단합니다"/>
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Margin="12,0,6,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryText}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 저장소 목록 -->
            <DockPanel Grid.Column="0">
                <TextBlock x:Name="BasePathText"
                           DockPanel.Dock="Top"
                           Margin="8,6"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryText}"/>
                <ListBox x:Name="RepoList"
                         BorderThickness="0,1,0,0"
                         SelectionChanged="RepoList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding RootPath}">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>

            <Grid Grid.Column="2" x:Name="DetailRoot" IsEnabled="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="SectionNav"
                         Grid.Row="0"
                         BorderThickness="0,0,0,1"
                         Background="{DynamicResource SurfaceBackground}"
                         SelectionChanged="SectionNav_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Tag="Changes" Padding="14,6">변경 사항</ListBoxItem>
                    <ListBoxItem Tag="Branches" Padding="14,6">브랜치</ListBoxItem>
                    <ListBoxItem Tag="Remote" Padding="14,6">원격 비교</ListBoxItem>
                    <ListBoxItem Tag="Log" Padding="14,6">로그</ListBoxItem>
                </ListBox>

                <!-- 변경 사항: 왼쪽 목록(변경됨/스테이지됨), 오른쪽 선택 파일 diff -->
                <Grid x:Name="ChangesSection" Grid.Row="1" Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" MinWidth="200"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="60"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*" MinHeight="60"/>
                        </Grid.RowDefinitions>

                        <!-- 변경됨 ↔ 스테이지됨 높이 조절 -->
                        <GridSplitter Grid.Row="2"
                                      Height="8"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      Background="Transparent"
                                      Cursor="SizeNS"
                                      ToolTip="끌어서 변경됨·스테이지됨 목록 높이를 조절합니다"/>

                        <CheckBox x:Name="ChangesTreeToggle"
                                  Grid.Row="0"
                                  Margin="2,0,0,6"
                                  Content="트리로 보기"
                                  Foreground="{DynamicResource PrimaryText}"
                                  Click="ChangesTreeToggle_Click"
                                  ToolTip="변경 파일을 폴더별로 묶어 봅니다. 폴더를 선택해 스테이지/언스테이지하면 그 아래 전체가 대상입니다."/>

                        <DockPanel Grid.Row="1">
                            <DockPanel DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="StageButton" Content="스테이지 ↓" Click="Stage_Click"/>
                                    <Button x:Name="StageAllButton" Content="전체" Click="StageAll_Click"
                                            ToolTip="git add -A"/>
                                </StackPanel>
                                <TextBlock x:Name="UnstagedHeader" VerticalAlignment="Center" FontWeight="SemiBold" Text="변경됨"/>
                            </DockPanel>
                            <Grid>
                                <ListBox x:Name="UnstagedList"
                                         SelectionMode="Extended"
                                         FontFamily="Consolas"
                                         DisplayMemberPath="DisplayText"
                                         SelectionChanged="UnstagedList_SelectionChanged"
                                         MouseDoubleClick="ChangeList_MouseDoubleClick"
                                         ToolTip="선택하면 오른쪽에 작업 트리 ↔ 인덱스 차이를 보입니다. 더블클릭하면 파일을 엽니다."/>
                                <TreeView x:Name="UnstagedTree"
                                          Visibility="Collapsed"
                                          Style="{StaticResource GitChangeTreeStyle}"
                                          SelectedItemChanged="UnstagedTree_SelectedItemChanged"
                                          MouseDoubleClick="ChangeTree_MouseDoubleClick"/>
                            </Grid>
                        </DockPanel>

                        <DockPanel Grid.Row="3">
                            <DockPanel DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="UnstageButton" Content="↑ 언스테이지" Click="Unstage_Click"/>
                                    <Button x:Name="UnstageAllButton" Content="전체" Click="UnstageAll_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="StagedHeader" VerticalAlignment="Center" FontWeight="SemiBold" Text="스테이지됨"/>
                            </DockPanel>
                            <Grid>
                                <ListBox x:Name="StagedList"
                                         SelectionMode="Extended"
                                         FontFamily="Consolas"
                                         DisplayMemberPath="DisplayText"
                                         SelectionChanged="StagedList_SelectionChanged"
                                         MouseDoubleClick="ChangeList_MouseDoubleClick"
                                         ToolTip="선택하면 오른쪽에 인덱스 ↔ HEAD 차이(커밋될 내용)를 보입니다."/>
                                <TreeView x:Name="StagedTree"
                                          Visibility="Collapsed"
                                          Style="{StaticResource GitChangeTreeStyle}"
                                          SelectedItemChanged="StagedTree_SelectedItemChanged"
                                          MouseDoubleClick="ChangeTree_MouseDoubleClick"/>
                            </Grid>
                        </DockPanel>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <controls:GitDiffView x:Name="ChangesDiff" Grid.Column="2"/>

                    <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                        <Button x:Name="CommitButton"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Bottom"
                                Content="커밋"
                                MinWidth="80"
                                Click="Commit_Click"
                                ToolTip="스테이지된 변경을 커밋합니다 (Ctrl+Enter)"/>
                        <TextBox x:Name="CommitMessageBox"
                                 Height="70"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="CommitMessageBox_PreviewKeyDown"
                                 ToolTip="커밋 메시지 — 첫 줄은 제목, 빈 줄 뒤는 본문"/>
                    </DockPanel>
                </Grid>

                <!-- 브랜치 -->
                <DockPanel x:Name="BranchesSection" Grid.Row="1" Margin="6" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button x:Name="SwitchBranchButton" Content="전환" Click="SwitchBranch_Click"
                                ToolTip="선택한 브랜치로 전환 (원격 브랜치는 추적하는 로컬 브랜치를 만듭니다)"/>
                        <Button x:Name="NewBranchButton" Content="새 브랜치…" Click="NewBranch_Click"
                                ToolTip="현재 커밋에서 새 브랜치를 만들고 전환합니다"/>
                        <Button x:Name="DeleteBranchButton" Content="삭제" Click="DeleteBranch_Click"
                                ToolTip="병합된 로컬 브랜치만 삭제합니다 (git branch -d)"/>
                    </StackPanel>
                    <ListBox x:Name="BranchList"
                             FontFamily="Consolas"
                             DisplayMemberPath="DisplayText"
                             MouseDoubleClick="BranchList_MouseDoubleClick"/>
                </DockPanel>

                <!-- 원격 비교: 현재 브랜치 ↔ upstream (마지막 fetch 기준) -->
                <Grid x:Name="RemoteSection" Grid.Row="1" Margin="6" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" MinWidth="200"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                        <TextBlock x:Name="RemoteSummaryText" TextWrapping="Wrap" Margin="2,0,2,4"/>
                        <WrapPanel>
                            <Button x:Name="FetchSelectedButton" Content="⇣ fetch 후 비교" Click="FetchSelected_Click"
                                    ToolTip="이 저장소만 git fetch --prune 한 뒤 다시 비교합니다 (작업 트리는 바뀌지 않음)"/>
                            <Button x:Name="OutgoingDiffButton" Content="보낼 변경 전체" Click="OutgoingDiff_Click"
                                    ToolTip="git diff @{u}...HEAD — push하면 원격에 더해질 변경"/>
                            <Button x:Name="IncomingDiffButton" Content="받을 변경 전체" Click="IncomingDiff_Click"
                                    ToolTip="git diff HEAD...@{u} — pull하면 로컬에 들어올 변경"/>
                            <Button x:Name="WorkTreeDiffButton" Content="작업 트리 ↔ upstream" Click="WorkTreeVsUpstream_Click"
                                    ToolTip="git diff @{u} — 커밋 안 한 수정까지 포함한 로컬 전체와 upstream의 차이 (추적 안 되는 파일 제외)"/>
                        </WrapPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="OutgoingHeader" Grid.Row="0" FontWeight="SemiBold" Text="보낼 커밋 (push)" Margin="2,0,2,4"/>
                        <ListBox x:Name="OutgoingList" Grid.Row="1" DisplayMemberPath="ListText"
                                 SelectionChanged="RemoteCommitList_SelectionChanged"/>
                        <TextBlock x:Name="IncomingHeader" Grid.Row="2" FontWeight="SemiBold" Text="받을 커밋 (pull)" Margin="2,8,2,4"/>
                        <ListBox x:Name="IncomingList" Grid.Row="3" DisplayMemberPath="ListText"
                                 SelectionChanged="RemoteCommitList_SelectionChanged"/>
                    </Grid>

                    <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <controls:GitDiffView x:Name="RemoteDiff" Grid.Row="1" Grid.Column="2"/>
                </Grid>

                <!-- 로그: 위 커밋 목록, 아래 선택 커밋 diff -->
                <Grid x:Name="LogSection" Grid.Row="1" Margin="6" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                    </Grid.RowDefinitions>
                    <ListView x:Name="LogList" Grid.Row="0"
                              SelectionMode="Single"
                              SelectionChanged="LogList_SelectionChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <!-- 그래프 선이 행 사이에서 끊기지 않도록 행 높이를 고정하고 안쪽 여백·테두리를 없앤다. -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="Height" Value="22"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="GraphColumn" Header="그래프" Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:GitGraphCell Row="{Binding Graph}" Margin="-6,0,-6,0" VerticalAlignment="Stretch"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="해시" Width="80" DisplayMemberBinding="{Binding ShortHash}"/>
                                <GridViewColumn Header="제목" Width="380" DisplayMemberBinding="{Binding Subject}"/>
                                <GridViewColumn Header="참조" Width="170" DisplayMemberBinding="{Binding Refs}"/>
                                <GridViewColumn Header="작성자" Width="110" DisplayMemberBinding="{Binding Author}"/>
                                <GridViewColumn Header="날짜" Width="130" DisplayMemberBinding="{Binding TimeText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <controls:GitDiffView x:Name="LogDiff" Grid.Row="2" Margin="0,4,0,0"/>
                </Grid>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>

        <TextBox x:Name="OutputBox"
                 Grid.Row="3"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Background="{DynamicResource PanelBackground}"/>
    </Grid>
</Window>
