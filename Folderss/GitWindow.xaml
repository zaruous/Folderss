<Window x:Class="Folderss.GitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Folderss.Controls"
        Title="Git"
        Width="1100"
        Height="720"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="13"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <!-- 기본 동작 버튼 옆의 ▾: 누를 때만 옵션 대화상자를 연다(버튼 자체는 기본 옵션으로 바로 실행). -->
        <Style x:Key="OptionArrowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="▾"/>
            <Setter Property="Padding" Value="5,7"/>
            <Setter Property="Margin" Value="-2,3,3,3"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <!--
            상태 아이콘: 목록 기준 상태를 12×12 벡터 도형으로(이미지 파일 없음, 테마와 무관한 중간 톤 색).
            Stretch=None이라 좌표가 그대로 그려진다 — 선만 있는 도형(−)도 찌그러지지 않는다. 상태 이름은 툴팁.
        -->
        <Style x:Key="GitStatusIcon" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="ToolTip" Value="{Binding StatusLabel}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="3" Background="#26D19A66">
                            <Path x:Name="Glyph"
                                  Width="12" Height="12"
                                  Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="#D19A66"
                                  Data="M2,10 L2,8 L8,2 L10,4 L4,10 Z M7,3 L9,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Null}">
                                <Setter TargetName="Box" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Untracked">
                                <Setter TargetName="Box" Property="Background" Value="#2698C379"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="#6CBF4F"/>
                                <Setter TargetName="Glyph" Property="Data" Value="M6,1 A5,5 0 1 1 5.99,1 Z M6,3.5 L6,8.5 M3.5,6 L8.5,6"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter TargetName="Box" Property="Background" Value="#2698C379"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="#6CBF4F"/>
                                <Setter TargetName="Glyph" Property="Data" Value="M6,2 L6,10 M2,6 L10,6"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Deleted">
                                <Setter TargetName="Box" Property="Background" Value="#26E06C75"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="#E06C75"/>
                                <Setter TargetName="Glyph" Property="Data" Value="M2,6 L10,6"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Renamed">
                                <Setter TargetName="Box" Property="Background" Value="#264C9AFF"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="#4C9AFF"/>
                                <Setter TargetName="Glyph" Property="Data" Value="M2,6 L10,6 M7,3 L10,6 L7,9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Copied">
                                <Setter TargetName="Box" Property="Background" Value="#264C9AFF"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="#4C9AFF"/>
                                <Setter TargetName="Glyph" Property="Data" Value="M2,6 L10,6 M7,3 L10,6 L7,9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="TypeChanged">
                                <Setter TargetName="Glyph" Property="Data" Value="M6,1 L11,6 L6,11 L1,6 Z"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Conflict">
                                <Setter TargetName="Box" Property="Background" Value="#33FF5555"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="#FF5555"/>
                                <Setter TargetName="Glyph" Property="Data" Value="M6,1 L11,11 L1,11 Z M6,5 L6,7.5 M6,9.3 L6,9.4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Unchanged">
                                <Setter TargetName="Box" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SecondaryText}"/>
                                <Setter TargetName="Glyph" Property="Data" Value="M2,6 L5,9 L10,3"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 평면 목록 한 줄: [상태 아이콘] 경로 -->
        <DataTemplate x:Key="GitEntryTemplate">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                <ContentControl Style="{StaticResource GitStatusIcon}"/>
                <TextBlock Text="{Binding PathText}" FontFamily="Consolas" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- 변경 사항 트리 보기(변경됨·스테이지됨 공용). 기본은 모두 펼침. -->
        <Style x:Key="GitChangeTreeStyle" TargetType="TreeView">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                        <Setter Property="ToolTip" Value="{Binding Path}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource GitStatusIcon}"/>
                            <TextBlock Text="{Binding LabelText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="130" MinHeight="50"/>
        </Grid.RowDefinitions>

        <!-- 툴바 -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="RescanButton" Content="⟳ 다시 찾기" Click="Rescan_Click"
                            ToolTip="기준 폴더 아래 저장소를 다시 찾고 상태를 읽습니다"/>
                    <Button x:Name="FetchAllButton" Content="⇣ 전체 fetch" Click="FetchAll_Click"
                            ToolTip="목록의 모든 저장소에서 git fetch --prune을 실행합니다 (작업 트리는 바뀌지 않음)"/>
                    <Button x:Name="FetchAllOptionsButton" Style="{StaticResource OptionArrowButton}" Click="FetchAllOptions_Click"
                            ToolTip="전체 fetch 옵션… (prune, 모든 원격, 태그)"/>
                    <Border Width="1" Margin="6,4" Background="{DynamicResource BorderBrush}"/>
                    <Button x:Name="PullButton" Content="⇣ pull" Click="Pull_Click"
                            ToolTip="선택한 저장소만 pull (설정 > Git의 방식으로 바로 실행)"/>
                    <Button x:Name="PullOptionsButton" Style="{StaticResource OptionArrowButton}" Click="PullOptions_Click"
                            ToolTip="pull 옵션… (fast-forward만 / 병합 / rebase, 변경 임시 보관)"/>
                    <Button x:Name="PushButton" Content="⇡ push" Click="Push_Click"
                            ToolTip="선택한 저장소만 push (강제 푸시 없음)"/>
                    <Button x:Name="PushOptionsButton" Style="{StaticResource OptionArrowButton}" Click="PushOptions_Click"
                            ToolTip="push 옵션… (원격, upstream 설정, 태그)"/>
                    <Border Width="1" Margin="6,4" Background="{DynamicResource BorderBrush}"/>
                    <Button x:Name="OptionsButton" Content="설정…" Click="Options_Click"
                            ToolTip="설정 창의 Git 탭을 엽니다 (git 경로, pull 방식, 탐색, 로그). diff·외부 비교 도구는 비교 탭"/>
                    <Button x:Name="CancelButton" Content="취소" Click="Cancel_Click" IsEnabled="False"
                            ToolTip="진행 중인 탐색·git 명령을 중단합니다"/>
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Margin="12,0,6,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryText}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 저장소 목록 -->
            <DockPanel Grid.Column="0">
                <TextBlock x:Name="BasePathText"
                           DockPanel.Dock="Top"
                           Margin="8,6"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryText}"/>
                <ListBox x:Name="RepoList"
                         BorderThickness="0,1,0,0"
                         SelectionChanged="RepoList_SelectionChanged"
                         PreviewMouseRightButtonDown="RepoList_PreviewMouseRightButtonDown"
                         ContextMenuOpening="RepoList_ContextMenuOpening"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- 저장소 우클릭: 그 저장소의 git config(글로벌·로컬) 보기·저장 -->
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="설정…" Click="RepoConfig_Click"
                                      ToolTip="이 저장소의 인증·작성자 설정(git config)을 글로벌/로컬로 나눠 보고 저장합니다"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding RootPath}">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>

            <Grid Grid.Column="2" x:Name="DetailRoot" IsEnabled="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="SectionNav"
                         Grid.Row="0"
                         BorderThickness="0,0,0,1"
                         Background="{DynamicResource SurfaceBackground}"
                         SelectionChanged="SectionNav_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Tag="Changes" Padding="14,6">변경 사항</ListBoxItem>
                    <ListBoxItem Tag="Branches" Padding="14,6">브랜치</ListBoxItem>
                    <ListBoxItem Tag="Remote" Padding="14,6">원격 비교</ListBoxItem>
                    <ListBoxItem Tag="Log" Padding="14,6">로그</ListBoxItem>
                    <ListBoxItem Tag="Worktrees" Padding="14,6">워킹트리</ListBoxItem>
                    <ListBoxItem Tag="Stash" Padding="14,6">stash</ListBoxItem>
                </ListBox>

                <!-- 변경 사항: 왼쪽 목록(변경됨/스테이지됨), 오른쪽 선택 파일 diff -->
                <Grid x:Name="ChangesSection" Grid.Row="1" Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ChangesListColumn" Width="340" MinWidth="200"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="UnstagedListRow" Height="*" MinHeight="60"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition x:Name="StagedListRow" Height="*" MinHeight="60"/>
                            <!-- "변경 없는 파일 보기"를 켤 때만 높이를 준다(코드에서 0 ↔ 8/*). -->
                            <RowDefinition x:Name="UnchangedSplitterRow" Height="0"/>
                            <RowDefinition x:Name="UnchangedRow" Height="0"/>
                        </Grid.RowDefinitions>

                        <!-- 변경됨 ↔ 스테이지됨 높이 조절 -->
                        <GridSplitter Grid.Row="2"
                                      Height="8"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      Background="Transparent"
                                      Cursor="SizeNS"
                                      DragCompleted="ChangesSplitter_DragCompleted"
                                      ToolTip="끌어서 변경됨·스테이지됨 목록 높이를 조절합니다"/>

                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,6">
                            <CheckBox x:Name="ChangesTreeToggle"
                                      VerticalAlignment="Center"
                                      Content="트리로 보기"
                                      Foreground="{DynamicResource PrimaryText}"
                                      Click="ChangesTreeToggle_Click"
                                      ToolTip="변경 파일을 폴더별로 묶어 봅니다. 폴더를 선택해 스테이지/언스테이지하면 그 아래 전체가 대상입니다."/>
                            <CheckBox x:Name="UnchangedToggle"
                                      Margin="14,0,0,0"
                                      Content="변경 없는 파일 보기"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource PrimaryText}"
                                      Click="UnchangedToggle_Click"
                                      ToolTip="추적 중이고 바뀌지 않은 파일(git ls-files 중 변경 목록에 없는 것)을 아래 목록에 보입니다. 선택하면 내용을 봅니다."/>
                            <Button Content="stash 저장" Margin="14,0,0,0" Padding="8,3" Click="StashPush_Click"
                                    ToolTip="추적 중인 파일의 변경을 stash에 넣고 작업 트리를 되돌립니다 (git stash push)"/>
                            <Button Style="{StaticResource OptionArrowButton}" Padding="4,3" Margin="-2,0,0,0" Click="StashPushOptions_Click"
                                    ToolTip="stash 저장 옵션… (메시지, 새 파일 포함, 스테이지 유지, 고른 파일만)"/>
                        </WrapPanel>

                        <GridSplitter x:Name="UnchangedSplitter"
                                      Grid.Row="4"
                                      Height="8"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      Background="Transparent"
                                      Cursor="SizeNS"/>

                        <DockPanel x:Name="UnchangedPanel" Grid.Row="5" Visibility="Collapsed">
                            <TextBlock x:Name="UnchangedHeader" DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="SemiBold" Text="변경 없음"/>
                            <Grid>
                                <ListBox x:Name="UnchangedList"
                                         FontFamily="Consolas"
                                         ItemTemplate="{StaticResource GitEntryTemplate}"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         SelectionChanged="UnchangedList_SelectionChanged"
                                         MouseDoubleClick="ChangeList_MouseDoubleClick"
                                         ToolTip="선택하면 파일 내용을 봅니다. 더블클릭하면 파일을 엽니다."/>
                                <TreeView x:Name="UnchangedTree"
                                          Visibility="Collapsed"
                                          Style="{StaticResource GitChangeTreeStyle}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          SelectedItemChanged="UnchangedTree_SelectedItemChanged"
                                          MouseDoubleClick="ChangeTree_MouseDoubleClick"/>
                            </Grid>
                        </DockPanel>

                        <DockPanel Grid.Row="1">
                            <DockPanel DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="RestoreButton" Content="되돌리기…" Margin="0,0,6,0" Click="Restore_Click"
                                            ToolTip="선택한 파일의 변경을 버립니다 (git restore). 되돌릴 수 없어 확인 창을 거칩니다."/>
                                    <Button x:Name="StageButton" Content="스테이지 ↓" Click="Stage_Click"/>
                                    <Button x:Name="StageAllButton" Content="전체" Click="StageAll_Click"
                                            ToolTip="git add -A"/>
                                </StackPanel>
                                <TextBlock x:Name="UnstagedHeader" VerticalAlignment="Center" FontWeight="SemiBold" Text="변경됨"/>
                            </DockPanel>
                            <Grid x:Name="UnstagedDropArea" AllowDrop="True" DragOver="ChangeDrop_DragOver" DragLeave="ChangeDrop_DragLeave" Drop="ChangeDrop_Drop">
                                <ListBox x:Name="UnstagedList"
                                         SelectionMode="Extended"
                                         PreviewMouseLeftButtonDown="ChangeDrag_PreviewMouseLeftButtonDown"
                                         PreviewMouseLeftButtonUp="ChangeDrag_PreviewMouseLeftButtonUp"
                                         PreviewMouseMove="ChangeDrag_PreviewMouseMove"
                                         FontFamily="Consolas"
                                         ItemTemplate="{StaticResource GitEntryTemplate}"
                                         SelectionChanged="UnstagedList_SelectionChanged"
                                         MouseDoubleClick="ChangeList_MouseDoubleClick"
                                         KeyDown="UnstagedChanges_KeyDown"
                                         ToolTip="선택하면 오른쪽에 작업 트리 ↔ 인덱스 차이를 보입니다. 더블클릭하면 파일을 엽니다. 스테이지됨으로 끌어 놓으면 스테이지합니다. Delete 키로 고른 파일을 휴지통으로 보냅니다."/>
                                <TreeView x:Name="UnstagedTree"
                                          Visibility="Collapsed"
                                          PreviewMouseLeftButtonDown="ChangeDrag_PreviewMouseLeftButtonDown"
                                          PreviewMouseLeftButtonUp="ChangeDrag_PreviewMouseLeftButtonUp"
                                          PreviewMouseMove="ChangeDrag_PreviewMouseMove"
                                          Style="{StaticResource GitChangeTreeStyle}"
                                          SelectedItemChanged="UnstagedTree_SelectedItemChanged"
                                          MouseDoubleClick="ChangeTree_MouseDoubleClick"
                                          KeyDown="UnstagedChanges_KeyDown"/>
                                <!-- 끌어 놓기 대상 강조: 받을 수 있는 끌기가 위에 있을 때만 보인다(입력은 아래 목록으로 통과). -->
                                <Border x:Name="UnstagedDropHighlight" Visibility="Collapsed" IsHitTestVisible="False"
                                        BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}">
                                    <Grid>
                                        <Border Background="{DynamicResource AccentBrush}" Opacity="0.12"/>
                                        <TextBlock Text="여기에 놓으면 언스테이지" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DockPanel>

                        <DockPanel Grid.Row="3">
                            <DockPanel DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="UnstageButton" Content="↑ 언스테이지" Click="Unstage_Click"/>
                                    <Button x:Name="UnstageAllButton" Content="전체" Click="UnstageAll_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="StagedHeader" VerticalAlignment="Center" FontWeight="SemiBold" Text="스테이지됨"/>
                            </DockPanel>
                            <Grid x:Name="StagedDropArea" AllowDrop="True" DragOver="ChangeDrop_DragOver" DragLeave="ChangeDrop_DragLeave" Drop="ChangeDrop_Drop">
                                <ListBox x:Name="StagedList"
                                         SelectionMode="Extended"
                                         PreviewMouseLeftButtonDown="ChangeDrag_PreviewMouseLeftButtonDown"
                                         PreviewMouseLeftButtonUp="ChangeDrag_PreviewMouseLeftButtonUp"
                                         PreviewMouseMove="ChangeDrag_PreviewMouseMove"
                                         FontFamily="Consolas"
                                         ItemTemplate="{StaticResource GitEntryTemplate}"
                                         SelectionChanged="StagedList_SelectionChanged"
                                         MouseDoubleClick="ChangeList_MouseDoubleClick"
                                         ToolTip="선택하면 오른쪽에 인덱스 ↔ HEAD 차이(커밋될 내용)를 보입니다. 변경됨으로 끌어 놓으면 언스테이지합니다."/>
                                <TreeView x:Name="StagedTree"
                                          Visibility="Collapsed"
                                          PreviewMouseLeftButtonDown="ChangeDrag_PreviewMouseLeftButtonDown"
                                          PreviewMouseLeftButtonUp="ChangeDrag_PreviewMouseLeftButtonUp"
                                          PreviewMouseMove="ChangeDrag_PreviewMouseMove"
                                          Style="{StaticResource GitChangeTreeStyle}"
                                          SelectedItemChanged="StagedTree_SelectedItemChanged"
                                          MouseDoubleClick="ChangeTree_MouseDoubleClick"/>
                                <!-- 끌어 놓기 대상 강조: 받을 수 있는 끌기가 위에 있을 때만 보인다(입력은 아래 목록으로 통과). -->
                                <Border x:Name="StagedDropHighlight" Visibility="Collapsed" IsHitTestVisible="False"
                                        BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}">
                                    <Grid>
                                        <Border Background="{DynamicResource AccentBrush}" Opacity="0.12"/>
                                        <TextBlock Text="여기에 놓으면 스테이지" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"
                                  DragCompleted="ChangesSplitter_DragCompleted"/>

                    <controls:GitDiffView x:Name="ChangesDiff" Grid.Column="2"/>

                    <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                        <Button x:Name="CommitOptionsButton"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource OptionArrowButton}"
                                Click="CommitOptions_Click"
                                ToolTip="커밋 옵션… (직전 커밋 고치기, Signed-off-by, 빈 커밋)"/>
                        <Button x:Name="CommitButton"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Bottom"
                                Content="커밋"
                                MinWidth="80"
                                Click="Commit_Click"
                                ToolTip="스테이지된 변경을 커밋합니다 (Ctrl+Enter)"/>
                        <TextBox x:Name="CommitMessageBox"
                                 Height="70"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="CommitMessageBox_PreviewKeyDown"
                                 ToolTip="커밋 메시지 — 첫 줄은 제목, 빈 줄 뒤는 본문"/>
                    </DockPanel>
                </Grid>

                <!-- 브랜치 -->
                <DockPanel x:Name="BranchesSection" Grid.Row="1" Margin="6" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button x:Name="SwitchBranchButton" Content="전환" Click="SwitchBranch_Click"
                                ToolTip="선택한 브랜치로 전환 (원격 브랜치는 추적하는 로컬 브랜치를 만듭니다)"/>
                        <Button x:Name="NewBranchButton" Content="새 브랜치…" Click="NewBranch_Click"
                                ToolTip="현재 커밋에서 새 브랜치를 만들고 전환합니다"/>
                        <Button x:Name="DeleteBranchButton" Content="삭제" Click="DeleteBranch_Click"
                                ToolTip="병합된 로컬 브랜치만 삭제합니다 (git branch -d)"/>
                        <Button Style="{StaticResource OptionArrowButton}" Click="DeleteBranchOptions_Click"
                                ToolTip="삭제 옵션… (병합 안 된 브랜치 강제 삭제)"/>
                    </StackPanel>
                    <ListBox x:Name="BranchList"
                             FontFamily="Consolas"
                             DisplayMemberPath="DisplayText"
                             MouseDoubleClick="BranchList_MouseDoubleClick"/>
                </DockPanel>

                <!-- 원격 비교: 현재 브랜치 ↔ upstream (마지막 fetch 기준) -->
                <Grid x:Name="RemoteSection" Grid.Row="1" Margin="6" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" MinWidth="200"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                        <TextBlock x:Name="RemoteSummaryText" TextWrapping="Wrap" Margin="2,0,2,4"/>
                        <WrapPanel>
                            <Button x:Name="FetchSelectedButton" Content="⇣ fetch 후 비교" Click="FetchSelected_Click"
                                    ToolTip="이 저장소만 git fetch --prune 한 뒤 다시 비교합니다 (작업 트리는 바뀌지 않음)"/>
                            <Button Style="{StaticResource OptionArrowButton}" Click="FetchSelectedOptions_Click"
                                    ToolTip="fetch 옵션… (prune, 모든 원격, 태그)"/>
                            <Button x:Name="OutgoingDiffButton" Content="보낼 변경 전체" Click="OutgoingDiff_Click"
                                    ToolTip="git diff @{u}...HEAD — push하면 원격에 더해질 변경"/>
                            <Button x:Name="IncomingDiffButton" Content="받을 변경 전체" Click="IncomingDiff_Click"
                                    ToolTip="git diff HEAD...@{u} — pull하면 로컬에 들어올 변경"/>
                            <Button x:Name="WorkTreeDiffButton" Content="작업 트리 ↔ upstream" Click="WorkTreeVsUpstream_Click"
                                    ToolTip="git diff @{u} — 커밋 안 한 수정까지 포함한 로컬 전체와 upstream의 차이 (추적 안 되는 파일 제외)"/>
                        </WrapPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="OutgoingHeader" Grid.Row="0" FontWeight="SemiBold" Text="보낼 커밋 (push)" Margin="2,0,2,4"/>
                        <ListBox x:Name="OutgoingList" Grid.Row="1" DisplayMemberPath="ListText"
                                 SelectionChanged="RemoteCommitList_SelectionChanged"/>
                        <TextBlock x:Name="IncomingHeader" Grid.Row="2" FontWeight="SemiBold" Text="받을 커밋 (pull)" Margin="2,8,2,4"/>
                        <ListBox x:Name="IncomingList" Grid.Row="3" DisplayMemberPath="ListText"
                                 SelectionChanged="RemoteCommitList_SelectionChanged"/>
                    </Grid>

                    <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <controls:GitDiffView x:Name="RemoteDiff" Grid.Row="1" Grid.Column="2"/>
                </Grid>

                <!-- stash: 목록(위)·선택한 stash의 diff(아래) -->
                <Grid x:Name="StashSection" Grid.Row="1" Margin="6" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="60"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="2*" MinHeight="80"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="stash 저장" Click="StashPush_Click"
                                ToolTip="추적 중인 파일의 변경을 stash에 넣고 작업 트리를 되돌립니다"/>
                        <Button Style="{StaticResource OptionArrowButton}" Click="StashPushOptions_Click"
                                ToolTip="stash 저장 옵션… (메시지, 새 파일 포함, 스테이지 유지, 고른 파일만)"/>
                        <Border Width="1" Margin="6,4" Background="{DynamicResource BorderBrush}"/>
                        <Button x:Name="StashApplyButton" Content="적용" Click="StashApply_Click" IsEnabled="False"
                                ToolTip="선택한 stash를 작업 트리에 적용합니다 (stash는 남김, git stash apply)"/>
                        <Button x:Name="StashApplyOptionsButton" Style="{StaticResource OptionArrowButton}" Click="StashApplyOptions_Click" IsEnabled="False"
                                ToolTip="적용 옵션… (적용 후 삭제 pop, 새 브랜치로 꺼내기, 스테이지 상태 복원)"/>
                        <Button x:Name="StashDropButton" Content="삭제" Click="StashDrop_Click" IsEnabled="False"
                                ToolTip="선택한 stash를 삭제합니다 (git stash drop)"/>
                        <Button Style="{StaticResource OptionArrowButton}" Click="StashDropOptions_Click"
                                ToolTip="삭제 옵션… (모든 stash 삭제)"/>
                    </StackPanel>
                    <ListBox x:Name="StashList" Grid.Row="1"
                             FontFamily="Consolas"
                             DisplayMemberPath="DisplayText"
                             SelectionChanged="StashList_SelectionChanged"
                             MouseDoubleClick="StashApply_Click"/>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <controls:GitDiffView x:Name="StashDiff" Grid.Row="3" Margin="0,4,0,0"/>
                </Grid>

                <!-- 워킹트리: 목록·추가·제거·prune -->
                <DockPanel x:Name="WorktreesSection" Grid.Row="1" Margin="6" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="새 워킹트리…" Click="WorktreeAdd_Click"
                                ToolTip="다른 폴더에 이 저장소의 작업 트리를 하나 더 만듭니다 (새 브랜치 / 기존 브랜치)"/>
                        <Button Content="저장소 목록에서 보기" Click="WorktreeOpen_Click"
                                ToolTip="선택한 워킹트리를 왼쪽 저장소 목록에서 선택합니다 (없으면 추가). 더블클릭과 같습니다"/>
                        <Button Content="제거" Click="WorktreeRemove_Click"
                                ToolTip="워킹트리 폴더와 기록을 지웁니다. 커밋 안 한 변경이 있으면 git이 거부합니다"/>
                        <Button Style="{StaticResource OptionArrowButton}" Click="WorktreeRemoveOptions_Click"
                                ToolTip="제거 옵션… (커밋 안 한 변경까지 강제 제거)"/>
                        <Button Content="prune" Click="WorktreePrune_Click"
                                ToolTip="폴더가 이미 지워진 워킹트리의 기록을 정리합니다 (git worktree prune)"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="2,6,0,0" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource SecondaryText}"
                               Text="같은 브랜치는 두 워킹트리에서 동시에 체크아웃할 수 없습니다. 워킹트리 폴더는 탐색기에서 지우지 말고 '제거'를 쓰세요 (지웠다면 prune)."/>
                    <ListBox x:Name="WorktreeList"
                             FontFamily="Consolas"
                             DisplayMemberPath="DisplayText"
                             MouseDoubleClick="WorktreeList_MouseDoubleClick"/>
                </DockPanel>

                                <!-- 로그: 위 커밋 목록, 아래 선택 커밋 diff -->
                <Grid x:Name="LogSection" Grid.Row="1" Margin="6" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                    </Grid.RowDefinitions>
                    <!-- 선택한 커밋에 대한 작업. 각 버튼은 선택 대화상자를 연다. 목록 우클릭 메뉴도 같다. -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="LogResetButton" Content="이 커밋으로 reset…" Click="LogReset_Click" IsEnabled="False"
                                ToolTip="현재 브랜치를 선택한 커밋으로 되돌립니다 (soft / mixed / hard 선택)"/>
                        <Button x:Name="LogBranchButton" Content="여기서 브랜치…" Click="LogBranch_Click" IsEnabled="False"
                                ToolTip="선택한 커밋에서 새 브랜치를 만듭니다 (전환 여부 선택)"/>
                        <Button x:Name="LogCheckoutButton" Content="체크아웃…" Click="LogCheckout_Click" IsEnabled="False"
                                ToolTip="선택한 커밋으로 작업 트리를 옮깁니다 (새 브랜치로 / detached 선택)"/>
                    </StackPanel>
                    <ListView x:Name="LogList" Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="LogList_SelectionChanged"
                              ContextMenuOpening="LogList_ContextMenuOpening"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <!-- 그래프 선이 행 사이에서 끊기지 않도록 행 높이를 고정하고 안쪽 여백·테두리를 없앤다. -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="Height" Value="22"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="이 커밋으로 reset…" Click="LogReset_Click"/>
                                <MenuItem Header="여기서 브랜치…" Click="LogBranch_Click"/>
                                <MenuItem Header="체크아웃…" Click="LogCheckout_Click"/>
                                <Separator/>
                                <MenuItem Header="해시 복사" Click="LogCopyHash_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="GraphColumn" Header="그래프" Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:GitGraphCell Row="{Binding Graph}" Margin="-6,0,-6,0" VerticalAlignment="Stretch"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="해시" Width="80" DisplayMemberBinding="{Binding ShortHash}"/>
                                <GridViewColumn Header="제목" Width="380" DisplayMemberBinding="{Binding Subject}"/>
                                <GridViewColumn Header="참조" Width="170" DisplayMemberBinding="{Binding Refs}"/>
                                <GridViewColumn Header="작성자" Width="110" DisplayMemberBinding="{Binding Author}"/>
                                <GridViewColumn Header="날짜" Width="130" DisplayMemberBinding="{Binding TimeText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <controls:GitDiffView x:Name="LogDiff" Grid.Row="3" Margin="0,4,0,0"/>
                </Grid>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>

        <TextBox x:Name="OutputBox"
                 Grid.Row="3"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Background="{DynamicResource PanelBackground}"/>
    </Grid>
</Window>
